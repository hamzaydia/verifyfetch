{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.verifyfetch.com" }],
      "destination": "https://verifyfetch.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.verifyfetch.com" }],
      "destination": "https://verifyfetch.com/:path*",
      "permanent": true
    }
  ]
}
