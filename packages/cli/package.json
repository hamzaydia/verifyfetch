{
  "name": "@verifyfetch/cli",
  "version": "1.1.0",
  "description": "Generate SRI hashes and chunked verification for resumable downloads. Works with WASM, AI models, and any binary files.",
  "type": "module",
  "bin": {
    "verifyfetch": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "node ../../scripts/prepack-check.js",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest --passWithNoTests"
  },
  "dependencies": {
    "verifyfetch": "workspace:^",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "glob": "^10.3.0",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0",
    "@types/node": "^20.0.0"
  },
  "keywords": [
    "verifyfetch",
    "cli",
    "sri",
    "subresource-integrity",
    "hash",
    "sha256",
    "integrity",
    "security",
    "ci",
    "cd",
    "verify",
    "manifest",
    "wasm",
    "ai-models"
  ],
  "license": "Apache-2.0",
  "author": "Hamza Ezzaydia",
  "homepage": "https://verifyfetch.com",
  "bugs": {
    "url": "https://github.com/hamzaydia/verifyfetch/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hamzaydia/verifyfetch",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  }
}
