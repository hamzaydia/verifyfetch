{
  "name": "@verifyfetch/transformers",
  "version": "1.1.1",
  "description": "Verified, resumable model loading for Transformers.js. Integrity verification for AI models in the browser.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "node ../../scripts/prepack-check.js",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "transformers",
    "transformers.js",
    "huggingface",
    "onnx",
    "ai",
    "machine-learning",
    "browser-ai",
    "model-integrity",
    "integrity",
    "verification",
    "resumable",
    "download",
    "sri",
    "verifyfetch"
  ],
  "author": "Hamza Ezzaydia",
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hamzaydia/verifyfetch",
    "directory": "packages/transformers"
  },
  "homepage": "https://verifyfetch.com",
  "bugs": {
    "url": "https://github.com/hamzaydia/verifyfetch/issues"
  },
  "dependencies": {
    "verifyfetch": "workspace:^"
  },
  "peerDependencies": {
    "@huggingface/transformers": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "fake-indexeddb": "^6.2.5",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
